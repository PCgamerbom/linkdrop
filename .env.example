PORT=3000
NODE_ENV=development

# API de processamento de mídia (escolha uma das opções abaixo)
# Opção 1: yt-dlp API
MEDIA_API_URL=http://localhost:8081

# Opção 2: Seu próprio servidor de processamento
# MEDIA_API_URL=https://seu-servidor-de-processamento.com

# Segurança
CORS_ORIGIN=http://localhost:3000,https://seudominio.com

# Logs
LOG_LEVEL=info
